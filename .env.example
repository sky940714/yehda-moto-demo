# Server-side only. Never expose this key through NEXT_PUBLIC_* variables.
DEEPL_API_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yada
MYSQL_USER=yada
MYSQL_PASSWORD=
# 正式寄信與社群登入將在取得服務憑證後啟用。
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# 綠界：本機／測試階段請填官方測試環境資料；正式上線改成正式特店資料。
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_RETURN_URL=
ECPAY_ORDER_RESULT_URL=
# 綠界物流金鑰與金流金鑰為不同設定；正式環境請從綠界後台取得。
ECPAY_LOGISTICS_ENV=stage
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
ECPAY_LOGISTICS_SENDER_NAME=
ECPAY_LOGISTICS_SENDER_PHONE=
ECPAY_LOGISTICS_SENDER_ZIP=236
ECPAY_LOGISTICS_SENDER_ADDRESS=
